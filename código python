# 8. Árbol propagación
ax8 = fig.add_subplot(gs[3, 1])
def draw_tree_simple(x, y, length, angle, depth, ax):
    if depth == 0: return
    x_end = x + length * np.cos(angle)
    y_end = y + length * np.sin(angle)
    ax.plot([x, x_end], [y, y_end], 'b-', linewidth=depth)
    draw_tree_simple(x_end, y_end, length*0.7, angle+0.5, depth-1, ax)
    draw_tree_simple(x_end, y_end, length*0.7, angle-0.5, depth-1, ax)

draw_tree_simple(0.5, 0, 0.3, np.pi/2, 4, ax8)
ax8.set_title('8. Árbol de Propagación Viral')
ax8.axis('equal')
ax8.axis('off')

# 9. Raíces características
